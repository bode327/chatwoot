<%# app/views/super_admin/plugins/edit.html.erb %>
<div class="row">
  <div class="col-lg-6 offset-lg-3">
    <div class="card mt-4">
      <div class="card-header">
        <h3>Edit / Upgrade Plugin</h3>
        <p>Current version: <strong><%= @plugin.version %></strong></p>
      </div>
      <div class="card-body">
        <% if flash[:error] %>
          <div class="alert alert-danger"><%= flash[:error] %></div>
        <% end %>

        <%= form_with(model: @plugin, url: super_admin_plugin_path(@plugin), local: true, html: { multipart: true, method: :put }) do |f| %>
          <div class="form-group mb-3">
            <%= f.label :file, "Upload New Plugin Zip File (to upgrade version)" %>
            <%= f.file_field :file, class: "form-control", accept: '.zip' %>
            <small class="form-text text-muted">Upload a new zip file to replace the existing code and upgrade the version.</small>
          </div>

          <div class="form-group mb-3">
            <div class="custom-control custom-switch">
              <%= f.check_box :active, class: "custom-control-input", id: "activeSwitch" %>
              <%= f.label :active, "Active", class: "custom-control-label", for: "activeSwitch" %>
            </div>
          </div>

          <%= f.submit "Update Plugin", class: "btn btn-primary" %>
          <%= link_to "Cancel", super_admin_plugins_path, class: "btn btn-secondary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
