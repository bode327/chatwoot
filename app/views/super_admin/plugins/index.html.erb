<% content_for(:title) do %>
  Plugins
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    Plugins
  </h1>

  <div>
    <%= link_to("Upload New Plugin", "/super_admin/plugins/new", class: "button") %>
  </div>
</header>

<section class="main-content__body main-content__body--flush">
  <table aria-labelledby="page-title">
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Identifier</th>
        <th>Version</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @plugins.each do |plugin| %>
        <tr class="js-table-row" tabindex="0">
          <td><%= plugin.id %></td>
          <td><%= plugin.name %></td>
          <td><%= plugin.identifier %></td>
          <td><%= plugin.version %></td>
          <td><%= plugin.active ? 'Active' : 'Inactive' %></td>
          <td>
            <%= link_to("View", "/super_admin/plugins/#{plugin.id}", class: "action-show") %>
            <%= link_to("Edit / Upgrade", "/super_admin/plugins/#{plugin.id}/edit", class: "action-edit") %>
            <%= link_to("Delete", "/super_admin/plugins/#{plugin.id}", method: :delete, data: { confirm: 'Are you sure?' }, class: "text-color-red") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>