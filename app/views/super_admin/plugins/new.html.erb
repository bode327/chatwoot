<% content_for(:title) do %>
  Upload New Plugin
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    Upload New Plugin
  </h1>

  <div>
    <%= link_to("Back", "/super_admin/plugins", class: "button") %>
  </div>
</header>

<section class="main-content__body">
  <%= form_with model: @plugin, url: "/super_admin/plugins", local: true, multipart: true do |f| %>
    <div class="field-unit">
      <div class="field-unit__label">
        <label>Plugin ZIP File</label>
      </div>
      <div class="field-unit__field">
        <%= f.file_field :file, required: true, accept: '.zip' %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit "Upload & Install", class: "button" %>
    </div>
  <% end %>
</section>